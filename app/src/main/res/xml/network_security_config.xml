<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS everywhere (Bing, OpenRouter, the user's Hermes), with no plain-http exception, Tailscale
     names included. A Hermes Live address on plain http is refused before anything is built or
     dialled (hermes/HermesAsk.kt). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
